<opinions>
	<constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
		<!-- EM_STM8.  SDCC leaves e_flags uninitialised (random bits), so the memory model cannot be read from the file:
		     the 16-bit (medium) language is chosen; use STM8:BE:24:default for images that need far pointers. -->
		<constraint primary="186" processor="STM8" endian="big" size="16"/>
	</constraint>
</opinions>
