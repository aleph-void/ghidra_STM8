      ]]></body>
    </pcode>
  </segmentop>
-->
  <segmentop space="RAM" userop="segment" farpointer="no">
    <pcode>
      <input name="base" size="3"/>
      <input name="inner" size="2"/>
      <output name="res" size="3"/>
      <body><![CDATA[
        res = base ^ zext(inner);
      ]]></body>
    </pcode>
<!--    <constresolve>
      <register name="physPage"/>
    </constresolve> -->
  </segmentop>



</processor_spec>
