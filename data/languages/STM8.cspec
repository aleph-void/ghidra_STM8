<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
	<global>
		<range space="RAM"/>
	</global>
	<data_organization>
		<absolute_max_alignment value="0" />
		<machine_alignment value="1" />
		<default_alignment value="1" />
		<pointer_size value="2" />
	</data_organization>

	<stackpointer register="SP" space="RAM"/>
	<!-- SDCC's stm8 convention: the first argument in A (8 bits), X (16 bits) or Y:X (32 bits), the others on the stack;
	     the result in A, X or Y:X.  CALL pushes a 2-byte return address, CALLF a 3-byte one. -->
	<default_proto>
		<prototype name="__stdcall" extrapop="2" stackshift="2" strategy="register">
			<input>
				<pentry maxsize="1" minsize="1">
					<register name="A"/>
				</pentry>
				<pentry maxsize="2" minsize="2">
					<register name="X"/>
				</pentry>
				<pentry maxsize="4" minsize="4">
					<addr space="join" piece1="Y" piece2="X"/>
				</pentry>
				<pentry maxsize="500" minsize="1" align="1">
					<addr space="stack" offset="3"/>
				</pentry>
			</input>
			<output>
				<pentry minsize="1" maxsize="1">
					<register name="A"/>
				</pentry>
				<pentry minsize="2" maxsize="2">
					<register name="X"/>
				</pentry>
				<pentry minsize="4" maxsize="4">
					<addr space="join" piece1="Y" piece2="X"/>
				</pentry>
			</output>
			<unaffected>
				<register name="SP"/>
			</unaffected>
			<killedbycall>
				<register name="A"/>
				<register name="X"/>
				<register name="Y"/>
				<register name="CC"/>
			</killedbycall>
		</prototype>
	</default_proto>

		<prototype name="__farcall" extrapop="3" stackshift="3" strategy="register">
			<input>
				<pentry maxsize="1" minsize="1">
					<register name="A"/>
				</pentry>
				<pentry maxsize="2" minsize="2">
					<register name="X"/>
				</pentry>
				<pentry maxsize="4" minsize="4">
					<addr space="join" piece1="Y" piece2="X"/>
				</pentry>
				<pentry maxsize="500" minsize="1" align="1">
					<addr space="stack" offset="4"/>
				</pentry>
			</input>
			<output>
				<pentry minsize="1" maxsize="1">
					<register name="A"/>
				</pentry>
				<pentry minsize="2" maxsize="2">
					<register name="X"/>
				</pentry>
				<pentry minsize="4" maxsize="4">
					<addr space="join" piece1="Y" piece2="X"/>
				</pentry>
			</output>
			<unaffected>
				<register name="SP"/>
			</unaffected>
			<killedbycall>
				<register name="A"/>
				<register name="X"/>
				<register name="Y"/>
				<register name="CC"/>
			</killedbycall>
		</prototype>

	<!-- a function that returns its result in the condition flags (for example a compare whose caller branches on Z):
	     set it as the calling convention of such a function -->
		<prototype name="__flagreturn" extrapop="2" stackshift="2" strategy="register">
			<input>
				<pentry maxsize="1" minsize="1">
					<register name="A"/>
				</pentry>
				<pentry maxsize="2" minsize="2">
					<register name="X"/>
				</pentry>
				<pentry maxsize="4" minsize="4">
					<addr space="join" piece1="Y" piece2="X"/>
				</pentry>
				<pentry maxsize="500" minsize="1" align="1">
					<addr space="stack" offset="3"/>
				</pentry>
			</input>
			<output>
				<pentry minsize="1" maxsize="1">
					<register name="CC"/>
				</pentry>
			</output>
			<unaffected>
				<register name="SP"/>
			</unaffected>
			<killedbycall>
				<register name="A"/>
				<register name="X"/>
				<register name="Y"/>
				<register name="CC"/>
			</killedbycall>
		</prototype>

</compiler_spec>
